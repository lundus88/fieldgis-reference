{
  "schema": "lds.legal-trust-readiness/1",
  "as_of": "2026-09-18",
  "production_ready": false,
  "applicable_basis": {
    "pdpa": "Personal Data Protection Act 2010 [Act 709] as amended",
    "electronic_trade": "Consumer Protection (Electronic Trade Transaction) Regulations 2024 [P.U. (A) 449/2024]"
  },
  "required_disclosures_bm": [
    "supplier_or_company_name",
    "website_address",
    "email",
    "telephone",
    "trade_address",
    "service_main_characteristics",
    "full_price_including_tax_and_other_cost",
    "payment_method",
    "sale_terms",
    "estimated_supply_time",
    "safety_health_certificate_if_applicable"
  ],
  "pending_verified_values": [
    "registered_entity_name",
    "registration_or_licence_particulars",
    "final_commercial_domain",
    "official_email",
    "official_phone",
    "official_trade_address",
    "support_complaint_channel",
    "policy_effective_dates"
  ],
  "order_controls": [
    "customer_can_correct_errors",
    "order_acknowledgement_without_undue_delay",
    "server_authoritative_full_price_before_payment"
  ],
  "privacy_controls": [
    "privacy_notice",
    "purpose_limitation",
    "data_minimisation",
    "least_privilege",
    "breach_response_runbook",
    "dpo_threshold_assessment_before_persistent_behaviour_monitoring"
  ],
  "launch_rule": "LEGAL_TRUST_READY remains HOLD while pending_verified_values is non-empty."
}