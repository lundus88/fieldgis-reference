{
  "schema": "lds.autonomous-operations/1",
  "status": "DEVELOPMENT_NON_PRODUCTION",
  "operating_principle": "Client triggers the business. LD runs the workflow. Human governs exceptions and authority gates.",
  "outcome_principle": "Reliable customer outcome first. Automation is the scaling mechanism.",
  "action_modes": [
    "AUTO",
    "AUTO_NOTIFY",
    "HUMAN_GATE"
  ],
  "components": {
    "capability_service_registry": {
      "mode": "AUTHORITATIVE_POLICY_INPUT"
    },
    "capacity_queue_manager": {
      "mode": "ADMISSION_CONTROL"
    },
    "outcome_acceptance_engine": {
      "mode": "EVIDENCE_GATE"
    },
    "operations_control_tower": {
      "mode": "READ_ONLY_COMPOSITION"
    },
    "autonomous_recovery_rollback": {
      "mode": "BOUNDED_NON_PRODUCTION_REPAIR"
    },
    "unit_economics_profit_guard": {
      "mode": "COMPOSES_PRICING_ESTIMATION_INTELLIGENCE"
    }
  },
  "no_idle_policy": {
    "enabled": true,
    "documented_blocker_required": true,
    "allowed_block_reasons": [
      "WAITING_CUSTOMER",
      "WAITING_PAYMENT",
      "WAITING_DEPENDENCY",
      "QUEUED_CAPACITY",
      "HUMAN_APPROVAL_REQUIRED",
      "QA_BLOCKED",
      "RECOVERY_IN_PROGRESS",
      "EXTERNAL_PROVIDER_OUTAGE",
      "COMPLIANCE_REVIEW",
      "COMMERCIAL_REVIEW"
    ]
  },
  "auto_kickoff_requires": [
    "authoritative_payment_reconciliation",
    "confirmed_requirement_scope",
    "supported_capability",
    "capacity_available",
    "unit_economics_pass",
    "no_unresolved_material_risk",
    "no_unverified_material_integration"
  ],
  "human_only": [
    "production_deployment_or_promotion",
    "destructive_production_data_action",
    "privilege_elevation",
    "material_contract_or_scope_exception",
    "refund_or_dispute_outside_policy",
    "unsupported_or_high_risk_compliance_decision",
    "unapproved_secret_or_credential_handling",
    "irreversible_customer_impact_without_rollback_evidence"
  ],
  "authority": {
    "autonomous_project_creation": true,
    "autonomous_work_package_generation": true,
    "autonomous_standard_build": true,
    "autonomous_nonproduction_qa": true,
    "bounded_nonproduction_self_repair": true,
    "production_deployment": false,
    "live_charging": false,
    "contract_exception_approval": false,
    "destructive_production_action": false
  }
}