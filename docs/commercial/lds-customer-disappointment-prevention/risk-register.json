{
  "schema": "lds.customer-disappointment-prevention/1",
  "status": "DEVELOPMENT_NON_PRODUCTION",
  "objective": "Detect and mitigate customer disappointment risk before it becomes a complaint, refund dispute, churn or reputational issue.",
  "severity": {
    "P0": "Trust/data/money/security failure requiring immediate human escalation",
    "P1": "Material delivery/support/expectation risk requiring same-business-day mitigation plan",
    "P2": "Customer frustration risk requiring proactive communication or workflow correction",
    "P3": "Minor/cosmetic issue tracked but not delivery-blocking"
  },
  "risks": [
    {
      "id": "CDP-001",
      "name": "Expectation mismatch",
      "severity": "P1",
      "triggers": [
        "scope_ambiguity",
        "acceptance_criteria_missing",
        "out_of_scope_missing"
      ],
      "controls": [
        "approved_sow",
        "explicit_exclusions",
        "acceptance_criteria"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-002",
      "name": "Unrealistic delivery promise",
      "severity": "P1",
      "triggers": [
        "eta_without_dependency_readiness",
        "capacity_overcommit"
      ],
      "controls": [
        "capacity_gate",
        "dependency_check",
        "human_approved_eta"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-003",
      "name": "No visible progress",
      "severity": "P2",
      "triggers": [
        "no_visible_artifact_within_72h_when_eligible"
      ],
      "controls": [
        "first_visible_value_target",
        "prototype_or_status_update"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-004",
      "name": "Customer dependency delay",
      "severity": "P2",
      "triggers": [
        "awaiting_customer_input",
        "awaiting_access",
        "awaiting_approval"
      ],
      "controls": [
        "timestamp_dependency",
        "client_action_required",
        "rebaseline_eta"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-005",
      "name": "Scope creep",
      "severity": "P1",
      "triggers": [
        "new_material_requirement_after_scope_lock"
      ],
      "controls": [
        "change_request",
        "variation_approval"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-006",
      "name": "Defect after delivery",
      "severity": "P1",
      "triggers": [
        "production_bug",
        "uat_escape"
      ],
      "controls": [
        "regression",
        "warranty_path",
        "incident_ticket"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-007",
      "name": "Support response/resolution delay",
      "severity": "P1",
      "triggers": [
        "first_response_sla_breach",
        "resolution_sla_breach",
        "ticket_unowned",
        "repeated_reopen"
      ],
      "controls": [
        "owner_assignment",
        "separate_first_response_and_resolution_sla",
        "resolution_checkpoint",
        "escalation"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-008",
      "name": "Refund/payment dispute",
      "severity": "P0",
      "triggers": [
        "duplicate_charge",
        "refund_dispute",
        "payment_state_uncertain"
      ],
      "controls": [
        "provider_evidence",
        "order_ledger",
        "human_financial_review"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-009",
      "name": "Data loss or failed recovery",
      "severity": "P0",
      "triggers": [
        "restore_failure",
        "backup_missing",
        "data_integrity_incident"
      ],
      "controls": [
        "backup",
        "restore_verification",
        "recovery_sop",
        "human_incident_escalation"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-010",
      "name": "Security incident",
      "severity": "P0",
      "triggers": [
        "credential_exposure",
        "unauthorized_access",
        "suspected_breach"
      ],
      "controls": [
        "containment",
        "audit_evidence",
        "human_security_escalation"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-011",
      "name": "Third-party dependency failure",
      "severity": "P1",
      "triggers": [
        "api_outage",
        "email_provider_failure",
        "payment_provider_failure"
      ],
      "controls": [
        "dependency_register",
        "fallback_or_hold",
        "status_update"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-012",
      "name": "AI output error",
      "severity": "P1",
      "triggers": [
        "consequential_ai_output_unverified"
      ],
      "controls": [
        "human_validation",
        "limitations_notice"
      ],
      "client_message_required": false
    },
    {
      "id": "CDP-013",
      "name": "Online-only feels unresponsive",
      "severity": "P2",
      "triggers": [
        "customer_followup_without_ack",
        "long_silence"
      ],
      "controls": [
        "text_first_ack",
        "named_owner",
        "scheduled_status_update"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-014",
      "name": "Ownership or exit misunderstanding",
      "severity": "P1",
      "triggers": [
        "source_code_ownership_unclear",
        "data_export_unclear",
        "hosting_transfer_unclear"
      ],
      "controls": [
        "sow_ownership_clause",
        "exit_path"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-015",
      "name": "Training/adoption failure",
      "severity": "P2",
      "triggers": [
        "repeated_how_to_queries",
        "uat_pass_but_usage_failure",
        "quick_start_not_completed",
        "core_workflow_not_used_after_handover"
      ],
      "controls": [
        "quick_start_guide",
        "recorded_walkthrough",
        "support_onboarding",
        "adoption_checkpoint"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-016",
      "name": "Client not fit for service",
      "severity": "P2",
      "triggers": [
        "budget_scope_mismatch",
        "governance_bypass_request",
        "unbounded_customisation"
      ],
      "controls": [
        "qualify",
        "decline_or_refer",
        "waitlist"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-017",
      "name": "Silent dissatisfaction",
      "severity": "P1",
      "triggers": [
        "post_milestone_pulse_need_attention",
        "repeated_minor_issue_signal",
        "repeat_followup_without_formal_complaint",
        "support_reopen_pattern_without_complaint"
      ],
      "controls": [
        "text_pulse_check",
        "named_owner",
        "proactive_followup",
        "root_cause_review"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-018",
      "name": "Handoff context loss",
      "severity": "P1",
      "triggers": [
        "owner_change_without_context_record",
        "customer_required_to_repeat_confirmed_information",
        "missing_scope_decision_history",
        "support_missing_project_context"
      ],
      "controls": [
        "single_customer_project_record",
        "handoff_context_check",
        "decision_history",
        "no_repeat_information_rule"
      ],
      "client_message_required": true
    },
    {
      "id": "CDP-019",
      "name": "Acknowledged but unresolved",
      "severity": "P1",
      "triggers": [
        "first_response_met_but_resolution_sla_breached",
        "multiple_status_replies_without_resolution_plan",
        "ticket_reopened_after_premature_close"
      ],
      "controls": [
        "separate_resolution_sla",
        "resolution_owner",
        "next_resolution_checkpoint",
        "escalate_stalled_ticket"
      ],
      "client_message_required": true
    }
  ],
  "mandatory_rules": [
    "P0 always HUMAN_ESCALATION",
    "No claim of READY/COMPLETE/ACCEPTED without evidence",
    "ETA must be rebaselined when material customer dependency blocks delivery",
    "Fast-track may not bypass QA/security/UAT",
    "Complaint prevention communication must be factual and must not conceal blockers",
    "Financial/refund/security decisions remain human-controlled",
    "No complaint does not equal satisfaction; explicit evidence is required before classifying customer experience as healthy after material milestones",
    "First response SLA and resolution SLA must be tracked separately",
    "Customer must not be required to repeat already-confirmed project information after internal handoff",
    "Post-handover adoption must be observed separately from technical UAT pass"
  ]
}
