    "P0": "Trust/data/money/security failure requiring immediate human escalation",
    "P1": "Material delivery/support/expectation risk requiring same-business-day mitigation plan",
    "P2": "Customer frustration risk requiring proactive communication or workflow correction",
    "P3": "Minor/cosmetic issue tracked but not delivery-blocking"
