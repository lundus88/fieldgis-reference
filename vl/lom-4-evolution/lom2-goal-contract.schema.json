{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lundus.local/lom2-goal-contract.schema.json",
  "title": "LOM 2.0 Goal Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_id", "objective", "success_criteria", "risk_class", "delegation", "evidence_required"],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "HUMAN_ONLY"]},
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_actions", "forbidden_actions"],
      "properties": {
        "allowed_actions": {"type": "array", "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
