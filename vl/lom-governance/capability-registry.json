  "specialist_on_demand": {
    "policy": "LOAD_ONLY_WHEN_DOMAIN_NEEDS_IT",
    "domains": [
      "ACCOUNTING_FINANCE",
      "LEGAL_COMPLIANCE",
      "COO_OPERATIONS",
      "PROCUREMENT",
      "RESEARCH",
      "OTHER_SPECIALIST_DOMAIN"
    ],
    "rule": "NO_PERMANENT_DUPLICATE_AGENT_WHEN_EXISTING_SPECIALIST_OR_ADAPTER_CAN_SERVE",
    "human_authority_preserved": true
  },
  "hr_policy": {
    "mode": "HR_ADAPTER_PLUS_SPECIALIST_HRMS",
    "duplicate_payroll_attendance_leave_engine_forbidden": true,
    "build_new_only_on_proven_gap": true
