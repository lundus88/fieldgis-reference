{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lom.event-envelope/1",
  "title": "LOM Canonical Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","event_id","event_type","source_component","objective_id",
    "occurred_at","evidence_refs","idempotency_key","risk_class",
    "target_environment","authority_requirement","correlation_id",
    "payload_digest","payload"
  ],
  "properties": {
    "schema": {"const": "lom.event-envelope/1"},
    "event_id": {"type":"string","minLength":1,"maxLength":200},
    "event_type": {"type":"string","pattern":"^[A-Z0-9._:-]{1,128}$"},
    "source_component": {"type":"string","minLength":1,"maxLength":200},
    "objective_id": {"type":"string","minLength":1,"maxLength":200},
    "project_id": {"type":["string","null"],"maxLength":200},
    "tenant": {"type":["string","null"],"maxLength":128},
    "actor_id": {"type":["string","null"],"maxLength":200},
    "producer_id": {"type":"string","minLength":1,"maxLength":200},
    "occurred_at": {"type":"string","format":"date-time"},
    "evidence_refs": {"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1,"maxLength":256}},
    "idempotency_key": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "risk_class": {"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "target_environment": {"enum":["development","staging","production"]},
    "authority_requirement": {"enum":["AUTO","AUTO_WITHIN_SCOPE","HUMAN_REVIEW","HUMAN_APPROVAL"]},
    "correlation_id": {"type":"string","minLength":1,"maxLength":200},
    "parent_event_id": {"type":["string","null"],"maxLength":200},
    "payload_digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "payload": {"type":"object"}
  }
}
