{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vrs-labs.local/schemas/agent-control-plane/action-envelope-v1.json",
  "title": "VL Agent Control Plane Action Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "requested_at",
    "expires_at",
    "requester",
    "capability",
    "scope",
    "provenance",
    "input_digest",
    "budget"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "action_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "agent_version", "role", "principal_type"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "agent_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "principal_type": { "enum": ["agent", "human", "system"] },
        "delegated_by": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9._:-]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "factory_run_id": { "type": "string", "format": "uuid" },
        "artifact_id": { "type": "string", "format": "uuid" },
        "connector": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target_environment": { "enum": ["development", "staging", "production"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id"],
      "properties": {
        "source_type": { "enum": ["user_request", "factory_run", "agent_action", "workflow", "system_event"] },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "parent_action_id": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_retries"],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_cost_minor": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}