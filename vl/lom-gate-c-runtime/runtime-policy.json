    "HUMAN_ONLY_ACTION",
    "UNKNOWN_AUTHORITY",
    "MISSING_REQUIRED_EVIDENCE",
    "CONTRADICTORY_EVIDENCE",
    "RISK_THRESHOLD_EXCEEDED",
    "PRODUCTION_BOUNDARY",
    "SECURITY_POLICY_CHANGE",
    "FINANCIAL_OR_CONTRACTUAL_COMMITMENT"
  ],
  "human_only_actions": [
    "PROTECTED_MAIN_MERGE",
    "PRODUCTION_DEPLOYMENT",
    "PRODUCTION_RELEASE",
    "PRODUCTION_DATA_MUTATION",
    "AUTHORITY_WIDENING",
    "SECURITY_POLICY_WIDENING",
    "CUSTOMER_OUTREACH",
    "BID_SUBMISSION",
    "QUOTATION_OR_PRICING_COMMITMENT",
    "CONTRACT_OR_LEGAL_COMMITMENT",
    "FINANCIAL_COMMITMENT"
  ],
  "allowed_autonomous_actions": [
    "READ_AUTHORIZED_SOURCE",
    "DRAFT_PLAN",
    "GENERATE_NON_PRODUCTION_ARTIFACT",
    "RUN_TEST",
    "RUN_STATIC_ANALYSIS",
    "CLASSIFY_RISK",
    "VALIDATE_OUTPUT",
    "REQUEST_EVIDENCE",
    "RECORD_EVIDENCE",
    "PROPOSE_LESSON"
  ]
}
