{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lom.technical-measurement-event/1",
  "title": "LOM 6.2 Technical Measurement Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["workload_id","evidence_sha","measured_at","sample_count","success_rate","correctness","safety","p95_latency_ms","source_kind","source_reference"],
  "properties": {
    "workload_id": {"type": "string", "minLength": 1},
    "evidence_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "measured_at": {"type": "string", "format": "date-time"},
    "sample_count": {"type": "integer", "minimum": 1},
    "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "correctness": {"type": "number", "minimum": 0, "maximum": 1},
    "safety": {"type": "number", "minimum": 0, "maximum": 1},
    "p95_latency_ms": {"type": "integer", "minimum": 0},
    "source_kind": {"enum": ["ci_artifact","nonprod_runtime","manual_verified"]},
    "source_reference": {"type": "string", "minLength": 1}
  }
}
